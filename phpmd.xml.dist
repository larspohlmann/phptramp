<?xml version="1.0"?>
<ruleset name="phptramp"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        Complexity-only PHPMD ruleset. Deliberately just the `codesize` rules —
        cyclomatic/NPath complexity, method/class length, and parameter/field/
        method counts — because those metrics are the one thing PHPStan (level
        max) and PHP_CodeSniffer (PSR-12) do NOT already cover. The noisier
        rulesets (cleancode, naming, controversial) are intentionally left out.

        To add another whole ruleset:  <rule ref="rulesets/design.xml" />
        To add a single rule:          <rule ref="rulesets/design.xml/CouplingBetweenObjects" />
    </description>

    <rule ref="rulesets/codesize.xml" />
</ruleset>
